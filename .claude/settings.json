{
  "permissions": {
    "deny": [
      "Bash(git push upstream:*)",
      "Bash(gh pr create --repo naver/longhorn-scheduler:*)",
      "Bash(gh pr create -R naver/longhorn-scheduler:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-upstream.sh"
          }
        ]
      }
    ]
  }
}
